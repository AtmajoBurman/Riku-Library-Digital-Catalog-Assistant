{
  "title": "FastAPI Metrics",
  "uid": "fastapi-metrics",
  "panels": [
    {
      "type": "timeseries",
      "title": "Total HTTP Requests (Rate 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (endpoint, method)", "legendFormat": "{{method}} {{endpoint}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Latency (95th percentile)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "{{endpoint}}" }
      ]
    }
  ],
  "schemaVersion": 38
}
